# ── Azure SQL (source of truth for contract inventory) ───────────────
AZURE_SQL_SERVER=icertis.database.windows.net
AZURE_SQL_DATABASE=Icertis
AZURE_SQL_USERNAME=icertis
AZURE_SQL_PASSWORD=AI/ML@2026

# ── SharePoint File Migration Platform integration ───────────────────
# Deployed Azure Container Apps platform. Validated end-to-end
# 2026-09-22 with real 3M + NDBS China files; see LIVE_API_TEST_REPORT.md.
MIGRATION_API_BASE_URL=https://ca-spmig-api.wittywater-29faa4f6.westeurope.azurecontainerapps.io
MIGRATION_API_TIMEOUT=30
MIGRATION_POLL_INTERVAL_SECONDS=5
MIGRATION_DEFAULT_PRIORITY=3
MIGRATION_NAME_PREFIX=Wave2

# ── Destination SharePoint (where files land after migration) ────────
# Confirmed working destination during live API test.  Under
# MIGRATION_DEST_FOLDER_PATH the source subfolder structure is
# preserved so links keep working.
MIGRATION_DEST_SITE_URL=https://itellicloud.sharepoint.com/sites/aiml_us_solutions
MIGRATION_DEST_LIBRARY=Shared Documents
MIGRATION_DEST_FOLDER_PATH=Migrated/Wave2

# ── Migration platform PostgreSQL (direct-read fallback) ─────────────
# Used by /api/migrations/sync when the platform HTTP API is unreachable
# or returns stale/incomplete data.  Read-only, per-file status only.
# Leave MIGRATION_DB_URL blank to disable the fallback entirely.
MIGRATION_DB_URL=postgresql://pgadmin:b5d63b32ea9ef22f729ee47fde5994716926911d@psql-spmig-2026.postgres.database.azure.com:5432/migration_db?sslmode=require
MIGRATION_DB_CONNECT_TIMEOUT=10
